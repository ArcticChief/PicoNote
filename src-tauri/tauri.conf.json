{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicoNote",
  "version": "1.1.0",
  "identifier": "com.piconote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PicoNote",
        "width": 1200,
        "height": 800,
        "minWidth": 650,
        "minHeight": 450,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0d0f17"
      }


    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": ["txt", "json", "js", "ts", "py", "css", "html", "yaml", "yml", "sh", "rs", "go", "sql"],
        "name": "Text Document",
        "description": "Text Document",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
